# Decision engine. Anything speaking the Jev protocol works.
# Default: a local semif-serve instance (https://github.com/dddanielliu/semif-serve).
# For hosted Jev instead: TYPESAFE_BASE_URL=https://api.typesafe.ai plus a key below.
TYPESAFE_BASE_URL=http://127.0.0.1:8077
# Required by hosted Jev. Optional for a self-hosted endpoint that runs unauthenticated.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
# SemIf does not generate text, so this stays a separate model whichever engine you choose.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
