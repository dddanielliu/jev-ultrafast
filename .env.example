# Decision engine. Defaults to hosted Jev; point it at any endpoint speaking the same protocol.
# Uncomment for a local semif-serve instance (https://github.com/dddanielliu/semif-serve).
# TYPESAFE_BASE_URL=http://127.0.0.1:8077
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
